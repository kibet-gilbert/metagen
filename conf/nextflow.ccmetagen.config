/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/nextflow.ccmetagen.config
    Configuration for the standalone CCMETAGEN_TAXONOMY subworkflow.

    Usage:
        nextflow run subworkflows/local/ccmetagen_taxonomy/main.nf \
            -entry CCMETAGEN_TAXONOMY_STANDALONE \
            -c conf/nextflow.ccmetagen.config \
            --reads  "fastq/*_{R1,R2}.fastq.gz" \
            --db     "/export/data/ilri/sarscov2/databases/ccmetagen_refseq" \
            -profile singularity
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// ---------------------------------------------------------------------------
// Pipeline parameters — override on CLI with --param value
// ---------------------------------------------------------------------------
params {

    // ── Inputs (REQUIRED) ──────────────────────────────────────────────────
    reads                = null     // glob: "fastq/*_{R1,R2}.fastq.gz"
    outdir               = "results/ccmetagen"

    // ── DB configuration (REQUIRED — choose one mode) ─────────────────────
    // MODE 'prebuilt'     → point --db to existing KMA DB directory
    // MODE 'blast_export' → set blast_db_prefix; will export then clean + index
    // MODE 'build'        → set ccmetagen_keyword (RefSeq|NCBI_nt); build from FASTA
    // MODE 'download'     → set ccmetagen_keyword; wget pre-built from Unimelb
    ccmetagen_db_mode    = 'prebuilt'      // prebuilt | blast_export | build | download
    ccmetagen_db         = null            // path (prebuilt mode) OR keyword (build/download)
    ccmetagen_keyword    = null            // RefSeq | NCBI_nt | NCBI_nt_no_env
    ccmetagen_taxon      = 'bacteria'      // taxon for RefSeq build (e.g. 'bacteria', 'fungi')

    // ── BLAST export settings (blast_export mode only) ─────────────────────
    blast_db_prefix      = null            // e.g. "/export/data/ncbi/blast/db/v5/core_nt"
    blast_db_name        = 'nt'            // short label for the DB

    // ── Read settings ──────────────────────────────────────────────────────
    single_end           = false

    // ── KMA alignment settings ─────────────────────────────────────────────
    kma_mem_mode         = true            // use memory-efficient mapping
    kma_extra_args       = ''             // any additional kma flags

    // ── CCMetagen settings ─────────────────────────────────────────────────
    ccmetagen_depth      = 0              // minimum read depth filter (0 = off)
    ccmetagen_mapstat    = true           // include mapstat in CCMetagen.py input

    // ── FASTA cleaning settings (blast_export mode) ───────────────────────
    fasta_min_len        = 300            // minimum sequence length to keep
    fasta_mask           = 0             // 1 = run dustmasker, 0 = skip
    fasta_dedup          = 0             // 1 = deduplicate sequences, 0 = skip
}

// ---------------------------------------------------------------------------
// Process resources and ext.args
// ---------------------------------------------------------------------------
process {

    // Global defaults
    cpus   = 4
    memory = '16.GB'
    time   = '6.h'

    // ── DB build/export processes ──────────────────────────────────────────

    withName: 'BLAST_EXPORT' {
        cpus   = 8
        memory = '32.GB'
        time   = '24.h'
        ext.compress   = '1'
        ext.header_fmt = '>%T|%t\\n%s'
    }

    withName: 'FASTA_CLEAN' {
        cpus   = 16
        memory = '64.GB'
        time   = '48.h'          // KMA indexing nt takes many hours
        ext.min_len          = "${params.fasta_min_len}"
        ext.mask_low_complex = "${params.fasta_mask}"
        ext.dedup_sequences  = "${params.fasta_dedup}"
        ext.keep_intermediate = '0'
    }

    withName: 'CCMETAGEN_DB' {
        cpus   = 16
        memory = '64.GB'
        time   = '48.h'
        ext.args = [
            '-NI',          // Do not dump *.index.b: False
            '-Sparse TG',   // Make Sparse DB ('-' for no prefix): None/False
            // '-ME',          // Mega DB: False
            // '-CS 100000000', // Start Chain size: 1000000 (1M)
            params.kma_index_args ?: ''
        ].join(' ').trim()
    }

    // ── Per-sample processes (run in parallel across all samples) ──────────

    withName: 'KMA_ALIGN' {
        cpus   = 8
        memory = '64.GB'          // KMA loads DB into memory
        time   = '12.h'
        ext.args = [
            '-mem_mode',          // stream reads, reduces peak RAM
            '-and',               // require both paired reads to map
            '-apm f',             // output all mapping information
            params.kma_extra_args ?: ''
        ].join(' ').trim()
    }

    withName: 'CCMETAGEN' {
        cpus   = 2
        memory = '8.GB'
        time   = '2.h'
        ext.args = [
            params.ccmetagen_depth > 0 ? "--depth ${params.ccmetagen_depth}" : ''
        ].join(' ').trim()
    }

    withName: 'CCMETAGEN_MERGE' {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
    }
}

// ---------------------------------------------------------------------------
// Output publishing
// ---------------------------------------------------------------------------
process {

    withName: 'BLAST_EXPORT' {
        publishDir = [
            path: "${params.outdir}/db_build/blast_export",
            mode: 'copy',
            enabled: true
        ]
    }

    withName: 'FASTA_CLEAN' {
        publishDir = [
            [
                path: "${params.outdir}/db_build/cleaned_fasta",
                mode: 'copy',
                pattern: "*.ccmetagen.fasta.gz"
            ],
            [
                path: "${params.outdir}/db_build/kma_index",
                mode: 'copy',
                pattern: "*_ccmetagen.{name,seq,len,comp}"
            ]
        ]
    }

    withName: 'CCMETAGEN_DB' {
        publishDir = [
            path: "${params.outdir}/db_build/kma_db",
            mode: 'copy',
            enabled: true
        ]
    }

    withName: 'KMA_ALIGN' {
        publishDir = [
            path: "${params.outdir}/kma",
            mode: 'copy',
            saveAs: { fn -> fn.endsWith('.res') || fn.endsWith('.mapstat') ? fn : null }
        ]
    }

    withName: 'CCMETAGEN' {
        publishDir = [
            path: "${params.outdir}/per_sample",
            mode: 'copy'
        ]
    }

    withName: 'CCMETAGEN_MERGE' {
        publishDir = [
            path: "${params.outdir}/combined",
            mode: 'copy'
        ]
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${params.outdir}/../singularity_cache"
        docker.enabled         = false
    }

    conda {
        conda.enabled       = true
        docker.enabled      = false
        singularity.enabled = false
    }

    // Quick test using 5 samples
    test {
        params.ccmetagen_db_mode = 'prebuilt'
        params.single_end        = false
        process.cpus             = 4
        process.memory           = '16.GB'
        process.time             = '2.h'
    }
}

// ---------------------------------------------------------------------------
// SLURM executor
// ---------------------------------------------------------------------------
executor {
    name            = 'slurm'
    queueSize       = 100           // CCMetagen is memory-intensive; cap parallelism
    submitRateLimit = '20/1min'
    pollInterval    = '30 sec'
}

// ---------------------------------------------------------------------------
// Nextflow tracing and reporting
// ---------------------------------------------------------------------------
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/ccmetagen_timeline.html"
    overwrite  = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/ccmetagen_report.html"
    overwrite  = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/ccmetagen_trace.tsv"
    overwrite  = true
    fields    = 'task_id,hash,name,status,exit,realtime,%cpu,rss,vmem,rchar,wchar'
}
