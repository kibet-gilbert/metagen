/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/nextflow.bracken.config
    Configuration for the standalone BRACKEN_REESTIMATE subworkflow.

    Usage:
        nextflow run subworkflows/local/bracken_reestimate/main.nf \
            -entry BRACKEN_REESTIMATE_STANDALONE \
            -c conf/nextflow.bracken.config \
            --kreports "kreports/kraken2/*.kraken2_report.txt" \
            --db       "/export/data/ilri/sarscov2/databases/kraken2_standard_db" \
            -profile singularity
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// ---------------------------------------------------------------------------
// Bracken run parameters — override any of these on the CLI with --param value
// ---------------------------------------------------------------------------
params {
    // ── Inputs (REQUIRED — set here or pass on CLI) ─────────────────────────
    kreports          = null     // glob: "kreports/kraken2/*.kraken2_report.txt"
    db                = null     // path: "/path/to/kraken2_bracken_database"
    outdir            = "results/bracken"

    // ── Bracken settings ────────────────────────────────────────────────────
    bracken_readlen = 150      // read length used during Kraken2 classification
    bracken_ktype   = 'kraken2' // version of kraken to use (kraken2|kraken|krakenuniq)
    bracken_level   = 'S'       // taxonomic level: S=species G=genus F=family
                                //                  O=order C=class P=phylum
    bracken_threshold = 10      // minimum reads to re-estimate a taxon
    bracken_build     = false   // true → run bracken/build to create kmer_distrib
                                // false → assume db already has kmer_distrib file
}

// ---------------------------------------------------------------------------
// Process resource configuration
// ---------------------------------------------------------------------------
process {

    // Default for all processes
    cpus   = 4
    memory = '16.GB'
    time   = '4.h'

    // bracken/build — only runs if params.bracken_build = true
    // Needs same resources as kraken2 (loads the full DB into memory)
    withName: 'BRACKEN_BUILD' {
        cpus   = 8
        memory = '64.GB'
        time   = '6.h'
        ext.args = [
            "-k 35",
            "-y ${params.bracken_ktype}",
            "-l ${params.bracken_readlen}"
        ].join(' ')
    }

    // bracken/bracken — runs once per kreport (1614 samples)
    // Lightweight: pure computation, no DB load after build
    withName: 'BRACKEN_BRACKEN' {
        cpus   = 2
        memory = '4.GB'
        time   = '30.min'
        errorStrategy = 'ignore'
        // errorStrategy = 'retry'
        // maxRetries = 3
        ext.args = [
            "-r ${params.bracken_readlen}",
            "-l ${params.bracken_level}",
            "-t ${params.bracken_threshold}"
        ].join(' ')
    }

    // bracken/combinebrackenoutputs — merges all 1614 reports into one table
    withName: 'BRACKEN_COMBINEBRACKENOUTPUTS' {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
    }
}

// ---------------------------------------------------------------------------
// Output publishing
// ---------------------------------------------------------------------------
process {
        withName: 'BRACKEN_BRACKEN' {
        errorStrategy = {
            def errFile = task.workDir?.resolve('.command.err')
            def errText = (errFile?.exists()) ? errFile.text : ''
    
            if (errText.contains('no reads found')) {
                println "[skip] ${task.process} → no reads at target taxonomic level in this Kraken2 report"
                return 'ignore'
            }
            if (task.exitStatus == 1 && task.attempt <= 5) {
                def sleep_ms = (long) (Math.pow(2, task.attempt) * 200)
                println "[retry] attempt=${task.attempt} sleeping ${sleep_ms} ms"
                sleep(sleep_ms)
                return 'retry'
            }
            println "[ignore] exceeded retries (attempt=${task.attempt})"
            return 'ignore'
        }
        maxRetries = 5   // <-- also required

        publishDir = [
            path: "${params.outdir}/bracken/per_sample",
            mode: 'copy',
            saveAs: { filename ->
                if ( filename.endsWith('.tsv') ) "bracken_reports/${filename}"
                else if (filename.endsWith('.txt')) "kreport_style/${filename}"
                else null
            }
        ]
    }

    withName: 'BRACKEN_COMBINEBRACKENOUTPUTS' {
        publishDir = [
            path: "${params.outdir}/bracken/combined",
            mode: 'copy'
        ]
    }

    withName: 'BRACKEN_BUILD' {
        publishDir = [
            path: "${params.outdir}/bracken/db_build",
            mode: 'copy',
            enabled: false    // DB stays in work dir; set true to save a copy
        ]
    }
}

// ---------------------------------------------------------------------------
// Singularity profile (matches your HPC setup)
// ---------------------------------------------------------------------------
profiles {
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${params.outdir}/../singularity_cache"
        docker.enabled         = false
    }

    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }

    test {
        params.kreports          = "kreports/kraken2/SPL145{5..9}.kraken2_report.txt"
        params.bracken_readlen   = 150
        params.bracken_level     = 'S'
        params.bracken_threshold = 10
        params.bracken_build     = false
        process.cpus   = 2
        process.memory = '4.GB'
        process.time   = '30.min'
    }
}

// ---------------------------------------------------------------------------
// Executor — SLURM (matches your HPC batch system)
// ---------------------------------------------------------------------------
executor {
    // name            = 'slurm'
    queueSize       = 200        // max simultaneous jobs; safe for 1614 samples
    submitRateLimit = '50/1min'  // avoid overwhelming the scheduler
    pollInterval    = '30 sec'
}

// ---------------------------------------------------------------------------
// Nextflow reporting
// ---------------------------------------------------------------------------
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/bracken_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/bracken_report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/bracken_trace.tsv"
    overwrite = true
    fields  = 'task_id,hash,name,status,exit,realtime,%cpu,rss,vmem,rchar,wchar'
}
