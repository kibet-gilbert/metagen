// =============================================================================
// conf/nextflow.validate_pathogen.config
//
// Configuration for the standalone pathogen validation pipeline.
// Loaded automatically when submitted via validate_pathogen.sbatch.
//
// Usage:
//   nextflow run validate_pathogen.nf \
//     -c conf/nextflow.validate_pathogen.config \
//     [other params]
// =============================================================================

// ── Global resource caps ──────────────────────────────────────────────────────
params {
    max_cpus   = 48
    max_memory = '256.GB'
    max_time   = '72.h'
    save_extracted_reads = true
}

// ── Process labels — resource tiers ──────────────────────────────────────────
// Override in your HPC profile if needed.
process {
    resourceLimits = [
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }

    withLabel: 'process_medium' {
        cpus   = 8
        memory = '32.GB'
        time   = '6.h'
    }

    withLabel: 'process_high' {
        cpus   = 16
        memory = '128.GB'
        time   = '48.h'
    }

    withLabel: 'process_high_memory' {
        cpus   = 8
        memory = '256.GB'
        time   = '24.h'
    }
}

// ── Module-level parameters ───────────────────────────────────────────────────
process {

    // ── KrakenTools extraction ────────────────────────────────────────────
    withName: 'KRAKENTOOLS_EXTRACTKRAKENREADS' {
        ext.include_children  = params.include_children   ?: true
        ext.include_parents   = params.include_parents    ?: false
        ext.fastq_output      = params.fastq_output       ?: false
        ext.max_reads         = params.max_reads_per_taxid ?: 50000
        cpus      = 8
        memory    = { 32.GB * task.attempt }
        time      = { 4.h   * task.attempt }
        maxForks  = 12
        maxRetries = 2

        // prefix is auto-set to meta.id in the module
        publishDir = [
            path:    "${params.outdir}/extracted_reads",
            mode:    params.publish_dir_mode ?: 'copy',
            pattern: "*.{fasta.gz,fastq.gz,summary.txt}",
            enabled: params.save_extracted_reads ?: true
        ]
    }

    // ── FASTA concatenation ───────────────────────────────────────────────
    withName: 'CONCAT_EXTRACTED_READS' {
        publishDir = [
            path:    "${params.outdir}/extracted_reads/combined",
            mode:    params.publish_dir_mode ?: 'copy',
            pattern: "*.combined.fasta",
            enabled: params.save_extracted_reads ?: true
        ]
    }

    // ── BLASTn ───────────────────────────────────────────────────────────
    withName: 'BLAST_BLASTN' {
        ext.db_mode         = params.blast_db_mode   ?: 'local'
        ext.task_mode       = params.blast_task       ?: 'megablast'
        ext.evalue          = params.blast_evalue     ?: '1e-20'
        ext.perc_identity   = params.blast_perc_id   ?: 95
        ext.qcov_hsp        = params.blast_qcov       ?: 80
        ext.max_target_seqs = params.blast_max_seqs   ?: 5
        cpus   = 4
        memory = { 300.GB * task.attempt }
        time   = { 24.h  * task.attempt }
        maxForks  = 2
        errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] || task.exitStatus == null
                          ? 'retry' : 'finish' }
        maxRetries = 2
        // Use dc-megablast for more divergent targets
        // (set via --blast_task dc-megablast on command line)
        publishDir = [
            path:    "${params.outdir}/blast",
            mode:    params.publish_dir_mode ?: 'copy',
            pattern: "*.{tsv,log}"
        ]
    }

    // ── Hit validation ────────────────────────────────────────────────────
    withName: 'VALIDATE_HITS' {
        ext.min_blast_hits = params.min_blast_hits ?: 3
        ext.min_pident     = params.min_pident     ?: 95.0
        ext.min_qcovs      = params.min_qcovs      ?: 80.0
        ext.min_bitscore   = params.min_bitscore   ?: 100.0
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 24.h  * task.attempt }
        errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] || task.exitStatus == null
                          ? 'retry' : 'finish' }
        maxRetries = 2
        publishDir = [
            path:    "${params.outdir}/validation",
            mode:    params.publish_dir_mode ?: 'copy',
            pattern: "*.{tsv,json}"
        ]
    }

    // ── Aggregation ───────────────────────────────────────────────────────
    withName: 'AGGREGATE_VALIDATION' {
        publishDir = [
            path:    "${params.outdir}/validation_summary",
            mode:    params.publish_dir_mode ?: 'copy',
            pattern: "*.{tsv,html}"
        ]
    }
}

// ── Execution profiles ────────────────────────────────────────────────────────
profiles {

    // ── ILRI HPC (SLURM + Apptainer) ─────────────────────────────────────
    ilri_hpc {
        // process.executor     = 'slurm'
        // process.queue        = 'batch'
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = '/var/scratch/gkibet/.apptainer_cache'

        process.containerOptions = [
            '--bind /home/gkibet',
            '--bind /var/scratch/gkibet',
            '--bind /export/data'
        ].join(' ')

        process.clusterOptions = '--nodes=1'

        // SLURM per-process resource requests
        process {
            withLabel: 'process_low' {
                cpus   = 2
                memory = '4.GB'
                time   = '1.h'
                clusterOptions = '--partition=batch --nodes=1'
            }
            withLabel: 'process_medium' {
                cpus   = 8
                memory = '32.GB'
                time   = '6.h'
                clusterOptions = '--partition=batch --nodes=1'
            }
            withLabel: 'process_high' {
                cpus   = 16
                memory = '128.GB'
                time   = '48.h'
                clusterOptions = '--partition=highmem --nodes=1'
            }
            withLabel: 'process_high_memory' {
                cpus   = 8
                memory = '256.GB'
                time   = '24.h'
                clusterOptions = '--partition=highmem --nodes=1'
            }
        }
    }

    // ── Apptainer / Singularity ─────────────────────────────────────────────
    // The default pullTimeout of 20 m was too short for large images on this node.
    // Increase to 60 m.  Also set the cache dir so images are reused across runs.
    apptainer {
        enabled    = true
        autoMounts = true
        pullTimeout = '60 min'
        cacheDir   = '/var/scratch/gkibet/.apptainer_cache'
    }
     
    // Keep these for environments that still use the 'singularity' directive name
    singularity {
        enabled    = true
        autoMounts = true
        pullTimeout = '60 min'
        cacheDir   = '/var/scratch/gkibet/.apptainer_cache'
    }

    // ── Conda ─────────────────────────────────────────────────────────────
    conda {
        conda.enabled = true
    }

    // ── Local (testing) ───────────────────────────────────────────────────
    local_test {
        process.executor = 'local'
        docker.enabled   = true
        params {
            max_cpus   = 4
            max_memory = '8.GB'
            max_time   = '2.h'
        }
    }
}

// ── Nextflow run configuration ────────────────────────────────────────────────
timeline {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    overwrite = true   // ← add this
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields  = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,cpus,%cpu,memory,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}

manifest {
    name            = 'validate_pathogen'
    description     = 'Orthogonal pathogen validation: KrakenTools + BLASTn'
    author          = 'ILRI Genomics Platform'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'validate_pathogen.nf'
}
